# Unofficial Linux package for the TLI-tracker-translated release (Electron app).
pkgname=tli-tracker
pkgver=1.3.0
pkgrel=1
pkgdesc='Torchlight: Infinite tracker (YiHuo ETor, English translation), Linux repack'
arch=('any')
url='https://github.com/Giboork/TLI-tracker-translated'
license=('custom')
depends=('electron')
makedepends=('npm' 'python')
noextract=("TLI-tracker-translated-v${pkgver}.zip")
source=("https://github.com/Giboork/TLI-tracker-translated/releases/download/v${pkgver}/TLI-tracker-translated-v${pkgver}.zip"
        'patch-app.js'
        'tli-tracker'
        'tli-tracker.desktop')
sha256sums=('ca1b7892f939c372ba3ac610b8b216764519293bb9316c6ea552bfb5a1c18edb'
            '0cc92db546aa104aedeedbbd8b9f7792714a9a47410d43b8b150241601fa32e5'
            'd385fb45fc0a88cc5d4a30ca6f942875bb7b89f2a5fb94579a126553b853b706'
            '74a61ce2b1499a4665c24fa93463a495cfe38587bd3035b61a0b84fed74a969d')

prepare() {
  # zip uses backslash separators; extract by name with python
  python - "TLI-tracker-translated-v${pkgver}.zip" <<'PY'
import sys, zipfile
z = zipfile.ZipFile(sys.argv[1])
for n in z.namelist():
    if n.replace('\\', '/') == 'resources/app.asar':
        open('app.asar', 'wb').write(z.read(n))
        break
else:
    sys.exit('app.asar not found in zip')
PY
  npx --yes @electron/asar extract app.asar app
  node patch-app.js app
  rm -f app/etor_*.ico
}

build() {
  npx --yes @electron/asar pack app app-linux.asar
}

package() {
  install -Dm644 app-linux.asar "$pkgdir/usr/lib/tli-tracker/app.asar"
  install -Dm755 tli-tracker "$pkgdir/usr/bin/tli-tracker"
  install -Dm644 tli-tracker.desktop "$pkgdir/usr/share/applications/tli-tracker.desktop"
  install -Dm644 app/etor.png "$pkgdir/usr/share/pixmaps/tli-tracker.png"
}
